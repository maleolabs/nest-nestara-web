@startuml pmptsp

skinparam linetype ortho

entity User {
    * id: bigint
    --
      nama: varchar(100) <<nullable>>
    * email: varchar(100)
    * password: varchar(255)
      foto: varchar(100)
    --
      deleted_at: datetime <<nullable>>
    * created_at: datetime
    * updated_at: datetime
}

entity Roles {
    * id: bigint
    --
    * nama: varchar(100)
    * guarded: varchar(10)
    --
    * created_at: datetime
    * updated_at: datetime
}

entity Pegawai {
    * id: bigint
    --
      user_id: unsignedBigInt <<nullable, FK>>
    * nama: varchar(100)
      nip: varchar(20) <<nullable>>
      jabatan: varchar(100) <<nullable>>
    --
      deleted_at: datetime <<nullable>>
    * created_at: datetime
    * updated_at: datetime
}

entity PeranPegawai {
    * id: bigint
    --
    * pegawai_id: unsignedBigInt <<FK>>
    * peran: enum('penandatangan', 'timteknis')
    --
    * created_at: datetime
    * updated_at: datetime
}

entity Pemohon {
    * id: bigint
    --
    * user_id: unsignedBigInt <<FK>>
    * sumber_identitas: varchar(5)
    * nomor_id: varchar(15)
    * nama_pemohon: varchar(100)
    * no_telepon: varchar(15)
    * provinsi: int
    * kabupaten: int
    * kecamatan: int
    * kelurahan: int
    * detail_alamat: varchar(255)
      alamat_luar_negeri: varchar(255) <<nullable>>
    --
      deleted_at: datetime <<nullable>>
    * created_at: datetime
    * updated_at: datetime
}

entity JenisPerizinan {
    * id: bigint
    --
    * nama: varchar(255)
    * kelopok_izin: varchar(100)
    * durasi: int
    * masa_berlaku: int
    --
      deleted_at: datetime <<nullable>>
    * created_at: datetime
    * updated_at: datetime
}

entity EntriData {
    * id: bigint
    --
    * jenis_perizinan_id: unsignedBigInt <<FK>>
    * nama: varchar (100)
    * tipe: varchar(20)
    * mandatori: boolean
    * max: int
    * is_mulsti_value: boolean
    * value_separator: varchar(5)
    --
      deleted_at: datetime <<nullable>>
    * created_at: datetime
    * updated_at: datetime
}

entity SyaratIzin {
    * id: bigint
    --
    * nama: varchar(255)
    * tipe: varchar(10)
    * online: boolean
    --
      deleted_at: datetime <<nullable>>
    * created_at: datetime
    * updated_at: datetime
}

entity DokumenPemohon {
    * id: bigint
    --
    * pemohon_id: unsignedBigInt <<FK>>
    * syarat_izin_id: unsignedBigInt <<FK>>
    * izin_id: unsignedBigInt <<FK>>
    * nama_file: varchar(255)
      nama_file_alternatif: varchar(255)
    --
    * created_at: datetime
    * updated_at: datetime
}

entity Izin {
    * id: bigint
    --
    * pemohon_id: unsignedBigInt <<FK>>
    * jenis_perizinan_id: unsignedBigInt <<FK>>
    * no_pendaftaran: int
    * jenis_permohonan: enum('baru', 'perubahan', 'perpanjangan')
      tanggal_peninjauan: datetime <<nullable>>
      lokasi_izin: varchar(255) <<nullable>>
      penada_tangan_id: unsignedBigInt <<nullable, FK>>
      nomor_surat: varchar(25) <<nullable>>
      ambil_entri_lama: boolean <<default: false>>
    --
      deleted_at: datetime <<nullable>>
    * created_at: datetime
    * updated_at: datetime
}

entity StatusIzin {
    * id: bigint
    --
    * izin_id: unsignedBigInt <<FK>>
    * nama: enum
    * keterangan: varchar(255)
    * progres: enum
      pegawai_id: unsignedBigInt <<FK>>
    --
    * created_at: datetime
    * updated_at: datetime
}

entity EntriDataIzin {
    * id: bigint
    --
    * entri_data_id: unsignedBigInt <<FK>>
    * izin_id: unsignedBigInt <<FK>>
    * value: text
    --
    * created_at: datetime
    * updated_at: datetime
}

entity Pengaturan {
    * id: bigint
    --
    * group: varchar(100)
    * nama: varchar(255)
      value: text <<nullable>>
      tipe: enum('text', 'int', 'boolean', 'datetime', 'json') <<default: 'text'>>
      user_id: unsignedBigInt <<nullable, FK>>
    --
    * created_at: datetime
    * updated_at: datetime
}

User }o--|{ Roles
User ||--o| Pemohon
User ||--o| Pegawai
Pegawai }o--|{ PeranPegawai
JenisPerizinan }|--o{ SyaratIzin
JenisPerizinan ||--o{ EntriData
EntriDataIzin }o--|| EntriData
DokumenPemohon }o--|| Pemohon
DokumenPemohon }o--|| SyaratIzin
Pemohon ||--o{ Izin
Izin |o--|{ DokumenPemohon
Izin ||--|{ StatusIzin
Izin }|--|{ EntriDataIzin
Izin }o--|| Pegawai: penanda_tangan
Izin }o--|{ Pegawai: tim_teknis
StatusIzin }o--o| Pegawai

@enduml